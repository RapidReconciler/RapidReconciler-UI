{
  "about": "VLC-223. The agent-log rules the Help Desk Log Analyzer (HelpDesk/log-analyzer.html) and VALC's Troubleshooting Step 2 both use: name, severity, pattern source and flags, in the order they are tried; the first match takes the line. Written by node Tools/test-agent-log-rules-shared.js --write from the Help Desk page. Valc's test-vlc223-help-desk-rules.js reads this file from main.",
  "rules": [
    {"name":"V8 Troubleshooting verdict (a page visit, not a fault)","severity":"noise","source":"\\.TroubleshootingController\\s*:\\s*troubleshooting verdict: \\S+ is \\S+ after \\S+ ms:","flags":""},
    {"name":"Database is read-only, so every write fails","severity":"crit","source":"because the database is read-only","flags":"i"},
    {"name":"Refresh job name is not set, so the agent crashes on every sync","severity":"crit","source":"Could not interpret JMS message[\\s\\S]{0,400}?NullPointerException[\\s\\S]{0,400}?synchronizeInstances","flags":"i"},
    {"name":"Timed out logging in to SQL Server","severity":"flag","source":"\\bLogin timed out\\b","flags":"i"},
    {"name":"Heartbeat","severity":"good","source":"\\bINFO\\b.*Sending heartbeat","flags":"i"},
    {"name":"Reported its heartbeat facts","severity":"good","source":"\\bHeartbeat-facts\\b.*\\bOK:\\s*2\\d\\d","flags":"i"},
    {"name":"Successful instance state","severity":"good","source":"\\bdbSystemStatus=success\\b","flags":""},
    {"name":"Connected to VALC","severity":"good","source":"\\b(Connected to VALC\\b.*queue|Client queue\\s*-\\s*[a-f0-9-]{8,})","flags":"i"},
    {"name":"Agent application started","severity":"good","source":"\\bStarted AgentApplication in [\\d.]+ seconds","flags":"i"},
    {"name":"Client services application started","severity":"good","source":"\\bStarted ClientServicesApplication\\b","flags":"i"},
    {"name":"Database connectivity OK","severity":"good","source":"\\bDatabase connectivity:\\s*\\[OK\\]","flags":"i"},
    {"name":"Instance JAR runnable","severity":"good","source":"\\bInstance JAR package runnable:\\s*\\[OK\\]","flags":"i"},
    {"name":"Pre-start check OK","severity":"good","source":"\\bService is not running:\\s*\\[OK\\]","flags":"i"},
    {"name":"Startup preconditions met","severity":"good","source":"\\bStartup preconditions met,\\s*proceeding\\b","flags":"i"},
    {"name":"Database connected","severity":"good","source":"\\bDatabase connected with success\\b","flags":"i"},
    {"name":"Instance is RUNNING","severity":"good","source":"\\bInstance that runs on \\S+ is RUNNING!","flags":"i"},
    {"name":"Notifying VALC of port","severity":"good","source":"\\bWarning VALC that database \\S+ runs on port \\d+","flags":"i"},
    {"name":"Environment confirmed at startup","severity":"good","source":"\\bThe following \\d+ profile(?:s)? (?:is|are) active:\\s*(\\S+)","flags":"i"},
    {"name":"Downloaded file checks out","severity":"good","source":"\\b(?:File integrity|SHA-?1).{0,120}?(?:OK|passed|verified|matches)\\b","flags":"i"},
    {"name":"Agent finished updating itself","severity":"good","source":"\\bSelf.?update\\b.{0,120}?(?:successful|completed|finished|done)\\b","flags":"i"},
    {"name":"Health probe during startup (expected)","severity":"noise","source":"HealthServiceImpl.*Could not load health endpoint.*Connection refused","flags":"i"},
    {"name":"Couldn't reach the old version to shut it down","severity":"noise","source":"HealthServiceImpl.*Could not access shutdown endpoint.*Connection refused","flags":"i"},
    {"name":"Instance startup polling","severity":"noise","source":"\\bChecking if instance is up attempt number\\b","flags":"i"},
    {"name":"VALC connection attempt","severity":"noise","source":"\\bTry connect to VALC\\b","flags":"i"},
    {"name":"VALC client queue assigned","severity":"noise","source":"\\bClient queue\\s*-\\s*[a-f0-9-]{8,}","flags":"i"},
    {"name":"Starting an instance","severity":"noise","source":"\\bStarting instance:\\s*ServicesInstance","flags":"i"},
    {"name":"Instance launch command","severity":"noise","source":"\\bExecuting:\\s*\\[.*java(\\.exe)?,","flags":"i"},
    {"name":"DB pre-flight check","severity":"noise","source":"\\bTrying to connect on database address\\b","flags":"i"},
    {"name":"Logback configurator","severity":"noise","source":"\\|\\s*-(INFO|WARN)\\s+in\\s+ch\\.qos\\.logback\\b","flags":"i"},
    {"name":"Spring Boot banner","severity":"noise","source":"^[\\s./\\\\():_|=`'.,*-]+$|::\\s*Spring Boot\\s*::","flags":"i"},
    {"name":"Log shipping","severity":"noise","source":"\\bINFO\\b.*Sending file .*\\.out\\.log","flags":"i"},
    {"name":"Company sync","severity":"noise","source":"\\bINFO\\b.*Sending company sync","flags":"i"},
    {"name":"Service instance status check","severity":"noise","source":"\\bINFO\\b.*ServiceInstance|monitoring\\s+\\d+\\s+instance","flags":"i"},
    {"name":"Routine update from VALC","severity":"noise","source":"\\bReceived\\s+SynchronizeMessage2?\\b","flags":"i"},
    {"name":"Receiving a program file from VALC","severity":"noise","source":"\\bReceived\\s+FileContentMessage\\b","flags":"i"},
    {"name":"Asking VALC for an update file","severity":"noise","source":"\\b(?:requestFile|Requesting file|Sending\\s+SendFileMessage)\\b","flags":"i"},
    {"name":"Stopping the old version","severity":"noise","source":"\\bStopping (?:instance|services)\\b","flags":"i"},
    {"name":"VALC asked the agent to update itself","severity":"flag","source":"\\bReceived\\s+SelfUpdateMessage\\b","flags":"i"},
    {"name":"A request took 20 seconds or more","severity":"flag","source":"RequestLogFilter\\s*:\\s*\\S+ \\S+ -> \\d{3} in (?:[2-9]\\d{4}|\\d{6,}) ms\\b","flags":""},
    {"name":"Routine INFO","severity":"noise","source":"\\bINFO\\b","flags":""},
    {"name":"The browser stopped waiting for a reply (benign)","severity":"noise","source":"response committed already\\b.*(?:connection was aborted|Broken pipe|ClientAbortException|Connection reset by peer)","flags":"i"},
    {"name":"Hibernate SqlExceptionHelper warning (benign)","severity":"noise","source":"\\bo\\.h\\.engine\\.jdbc\\.spi\\.SqlExceptionHelper\\b","flags":"i"},
    {"name":"Hikari driver SPI miss (benign)","severity":"noise","source":"com\\.zaxxer\\.hikari\\.util\\.DriverDataSource\\s*:?\\s*Registered driver with driverClassName=.*was not found, trying direct instantiation","flags":"i"},
    {"name":"Hibernate unknown SQL Server major version (benign)","severity":"noise","source":"HHH000385:\\s*Unknown Microsoft SQL Server major version \\[\\d+\\] using SQL Server 2000 dialect","flags":"i"},
    {"name":"Agent cannot reach a monitored database","severity":"flag","source":"(?:DatabaseManagerServiceMsSqlImpl|CompanySyncService)\\b.*(?:Login timed out|Socket closed|Error connecting to database|Error when quering|Error loading companies|Error removing licensed companies)","flags":"i"},
    {"name":"Briefly lost contact with VALC","severity":"flag","source":"\\b(?:Reconnect(?:ing)?|Try connect|connection (?:lost|dropped)).*?(?:broker|VALC|JMS)","flags":"i"},
    {"name":"WARN level","severity":"flag","source":"\\bWARN\\b","flags":""},
    {"name":"Connection failure","severity":"flag","source":"\\b(Connection (refused|reset|timed out)|SocketTimeoutException|ConnectException)\\b","flags":"i"},
    {"name":"Instance start timeout","severity":"flag","source":"Instance did not start after \\d+ seconds","flags":"i"},
    {"name":"Authentication or login failure","severity":"flag","source":"\\b(Authentication failed|login failed|invalid credentials|access denied)\\b","flags":"i"},
    {"name":"New version isn't reporting back","severity":"flag","source":"\\bCould not load version\\b","flags":"i"},
    {"name":"Can't reach VALC at all","severity":"crit","source":"\\bActiveMQ(?:NotConnected|ConnectionFailed)Exception\\b","flags":""},
    {"name":"Security check failed talking to VALC","severity":"crit","source":"\\bActiveMQSecurityException\\b","flags":""},
    {"name":"Don't trust VALC's security certificate","severity":"crit","source":"PKIX path building failed|unable to find valid certification path","flags":"i"},
    {"name":"VALC's certificate is for a different address","severity":"crit","source":"No subject alternative names? (?:matching|present)|HostnameVerifier.*?failed","flags":"i"},
    {"name":"Downloaded file looks corrupted","severity":"crit","source":"(?:SHA-?1.{0,120}?mismatch|integrity.{0,120}?fail|checksum.{0,120}?fail|file.{0,120}?corrupt)","flags":"i"},
    {"name":"VALC sent an update for something the agent doesn't have yet","severity":"flag","source":"ValcMessageListener.*Could not interpret JMS message","flags":"i"},
    {"name":"Database sync script returned the wrong row count","severity":"flag","source":"DatabaseManagerServiceMsSqlImpl.*Script FAILED to execute.*Incorrect result size","flags":"i"},
    {"name":"ERROR level","severity":"crit","source":"\\bERROR\\b","flags":""},
    {"name":"Stack trace","severity":"crit","source":"^\\s*at\\s+[\\w$.]+\\(.*\\)","flags":""},
    {"name":"Routine DEBUG","severity":"noise","source":"\\bDEBUG\\b","flags":""}
  ]
}
