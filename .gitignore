.vs/
.claude/
Tools/_test/
# Customer test fixtures — contain real F4095 routing, transaction detail,
# item ledger, etc. from production customer databases. Repo is public on
# GitHub, so fixtures stay local-only. The analyzer's auto-rehydrate fixture
# list in Tools/analysis-workbook.html silently falls through when these
# files aren't present (e.g. on the deployed site), so gitignoring them
# doesn't break anything customer-facing.
Tools/_test_corpus/fixtures/
Tools/_test_corpus/node_modules/
Tools/_test_corpus/package.json
Tools/_test_corpus/package-lock.json
*.dbmdl
agent-logs/

# Demo-mode data snapshots (dataPath in config.js, demo/?mode=demo only) are
# derived from real customer exports — real company numbers (00050/00010),
# accounts, items, docs. The repo is PUBLIC and GH-Pages-served, so ALL of these
# stay LOCAL-ONLY: the deployed site's demo mode degrades gracefully to the
# "data isn't loaded here" state, and staging/prod read live agent endpoints.
# Regenerate from the fictional Demo1 DB if a committed demo fixture is ever
# needed. NOTE: these were tracked historically, so git HISTORY still contains
# them — this stops FUTURE exposure only (UI-10).
RRV8/data/*.json

# Stray VALC restart-log dirs (relative -LogDir lands here) — not UI source
setup/

# UI-71 shared-figure regression harness. The PAGE is tracked (it is the test);
# its fixture is a dump of live demo rows and is NOT — the repo is public, and a
# committed fixture would also go stale silently. Regenerate it with the SQL in
# the page header before running the harness.
RRV8/_uitest/fixture.json

# Python bytecode from the Tools/ scripts (parsecheck, check_txv_cards, build-ai-grounding).
__pycache__/
*.pyc
